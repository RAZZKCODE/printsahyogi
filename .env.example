# Supabase project (Settings → API). The publishable key is safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only Supabase secret key (Settings → API → secret / service_role). Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of this site, used for the payment return URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# YouPI PG — self-hosted UPI gateway (https://github.com/youpi-pg/YouPI-PG).
# Base URL of your running YouPI Payment API (port 6100 locally), your merchant UUID from
# YouPI Merchant Admin, and the merchant webhook secret. Set the webhook URL in YouPI to
#   <NEXT_PUBLIC_SITE_URL>/api/payments/youpi/webhook
YOUPI_API_URL=http://localhost:6100
YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000000
YOUPI_WEBHOOK_SECRET=change-me
